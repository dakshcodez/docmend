{
  "name": "@docmend/core",
  "version": "0.1.0",
  "description": "Shared core logic for docmend: code/doc parsing, link graph, staleness detection, doc repair engine",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/dakshcodez/docmend#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dakshcodez/docmend.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/dakshcodez/docmend/issues"
  },
  "keywords": [
    "documentation",
    "docs",
    "llm",
    "gemini",
    "ai"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.17.0",
    "tree-sitter-wasms": "^0.1.13",
    "vectra": "^0.15.0",
    "web-tree-sitter": "^0.25.10"
  }
}
